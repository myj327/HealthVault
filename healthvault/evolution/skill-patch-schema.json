{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "healthvault-skill-local-patch-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["patches"],
  "properties": {
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patch_id",
          "operation",
          "source_trace_ids",
          "verification_source",
          "verification_strength",
          "target_section",
          "target_paragraph",
          "applicability_conditions",
          "when_not_to_use",
          "tool_path",
          "stop_conditions",
          "content",
          "rationale"
        ],
        "properties": {
          "patch_id": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "enum": ["add", "replace", "delete"]},
          "source_trace_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "verification_source": {
            "type": "string",
            "enum": ["deterministic", "user_confirmed", "semantic_judge"]
          },
          "verification_strength": {
            "type": "string",
            "enum": ["strong", "medium", "weak"]
          },
          "target_section": {"type": "string", "minLength": 1},
          "target_paragraph": {
            "type": "string", "minLength": 1,
            "description": "Exact existing paragraph in target_section. For add at section end, use the literal __section_end__."
          },
          "applicability_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "when_not_to_use": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "tool_path": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "stop_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "content": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
